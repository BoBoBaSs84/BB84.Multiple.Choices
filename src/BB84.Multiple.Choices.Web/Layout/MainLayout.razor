@inherits LayoutComponentBase
@using BB84.Multiple.Choices.Web.Common

<div class="container py-4">
	<header class="mb-4">
		<a href="/" class="text-decoration-none">
			<h1 class="display-6">🧠 @_headerTitle</h1>
		</a>
	</header>

	<main>
		@Body
	</main>

	<footer class="mt-4 text-muted small">
		<hr />
		<p>@_copyright</p>
	</footer>
</div>

@code {
	private string _copyright => AssemblyInformation.Copyright;
	private string _headerTitle => AssemblyInformation.Product;
}